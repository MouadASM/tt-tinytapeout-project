{
  "//1": "================================================================",
  "//2": "Vulkos - Tiny Tapeout LibreLane Configuration",
  "//3": "================================================================",
  "//4": "This is the default Vulkos configuration for Tiny Tapeout projects.",
  "//5": "It should work for most designs without modification.",

  "//6": "!!! DO NOT EDIT unless you understand what each variable does !!!",
  "//7": "A bad configuration can cause your project to fail the ASIC flow.",

  "//8": "If you get stuck, check the LibreLane configuration docs:",
  "//9": "https://librelane.readthedocs.io/en/latest/reference/configuration.html",

  "//10": "----------------------------------------------------------------",
  "//11": "PROJECT SETTINGS (edit these)",
  "//12": "----------------------------------------------------------------",
  "//13": "DESIGN_NAME - Must match the top-level module name in your Verilog.",
  "DESIGN_NAME": "tt_um_mouadasm_systolic",

  "//14": "VERILOG_FILES - List all source files for your design, relative to",
  "//15": "the project root. Add additional entries for multi-file designs.",
  "VERILOG_FILES": [
    "dir::src/project.v"
  ],

  "//16": "----------------------------------------------------------------",
  "//17": "COMMON TUNING KNOBS (edit only if needed)",
  "//18": "----------------------------------------------------------------",
  "//19": "PL_TARGET_DENSITY_PCT - Increase if Global Placement fails with",
  "//20": "error GPL-0302. Values up to 80 have been reported to work well.",
  "PL_TARGET_DENSITY_PCT": 75,

  "//21": "CLOCK_PERIOD - Increase if you are getting setup time violations.",
  "//22": "Value is in nanoseconds, so 20ns == 50MHz.",
  "CLOCK_PERIOD": 20,

  "//23": "Hold slack margins - Increase if you are getting hold violations.",
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.2,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.15,

  "//24": "RUN_LINTER, LINTER_INCLUDE_PDK_MODELS - Disabling the linter is",
  "//25": "not recommended.",
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "//26": "CLOCK_PORT - If you need a custom clock configuration, read this",
  "//27": "first: https://tinytapeout.com/faq/#how-can-i-map-an-additional-external-clock-to-one-of-the-gpios",
  "CLOCK_PORT": "clk",

  "//64": "----------------------------------------------------------------",
  "//65": "SETTINGS CARRIED OVER FROM THE CLEAN FLAT RUN (Entry 20)",
  "//66": "Kept identical so the flat and macro versions are a fair comparison.",
  "//67": "----------------------------------------------------------------",

  "RT_MAX_LAYER": "met4",
  "CTS_ROOT_BUFFER": "sky130_fd_sc_hd__clkbuf_4",
  "CTS_CLK_BUFFERS": [
    "sky130_fd_sc_hd__clkbuf_4",
    "sky130_fd_sc_hd__clkbuf_2"
  ],
  "RUN_POST_GRT_DESIGN_REPAIR": true,
  "DESIGN_REPAIR_MAX_SLEW_PCT": 50,
  "GRT_DESIGN_REPAIR_MAX_SLEW_PCT": 70,
  "DESIGN_REPAIR_BUFFER_INPUT_PORTS": false,

  "FP_DEF_TEMPLATE": "dir::tt_block_1x1_pg.def",

  "FP_PDN_HORIZONTAL_LAYER": "met3",
  "//28": "----------------------------------------------------------------",
  "//29": "DIE AREA",
  "//30": "----------------------------------------------------------------",
  "//31": "DIE_AREA format: \"x0 y0 x1 y1\" in microns.",
  "//32": "To change tile size, copy the value from one of the //DIE_AREA_*",
  "//33": "entries below into DIE_AREA itself. The // ones are reference only:",
  "//34": "LibreLane ignores any key starting with //, so only DIE_AREA counts.",
  "//35": "Easier: use the Visual tab, which offers these as a dropdown.",

  "//36": "A 1x1 tile fits roughly 4,000 standard cells at 60% density. If a run",
  "//37": "fails with \"Utilization NNN% exceeds 100%\", the design needs a bigger",
  "//38": "tile: 185% needs about twice the area, so go up two or three sizes.",

  "//39": "Tile sizes (matching what you would select on Tiny Tapeout):",

  "//40": "  1x1: 161.00 x 111.52 um   (this project)",
  "//41": "  1x2: 161.00 x 225.76 um",
  "//42": "  2x2: 334.88 x 225.76 um",
  "//43": "  3x2: 508.76 x 225.76 um",
  "//44": "  4x2: 682.64 x 225.76 um",
  "//45": "  6x2: 1030.40 x 225.76 um",
  "//46": "  8x2: 1378.16 x 225.76 um",
  "//47": "  3x4: 508.76 x 511.36 um",
  "//48": "  4x4: 682.64 x 511.36 um",
  "//49": "  5x4: 856.52 x 511.36 um",
  "//50": "  6x4: 1030.40 x 511.36 um",
  "//51": "  8x4: 1378.16 x 511.36 um",

  "DIE_AREA": "0 0 161.00 111.52",
  "//DIE_AREA_1x2": "0 0 161.00 225.76",
  "//DIE_AREA_2x2": "0 0 334.88 225.76",
  "//DIE_AREA_3x2": "0 0 508.76 225.76",
  "//DIE_AREA_4x2": "0 0 682.64 225.76",
  "//DIE_AREA_6x2": "0 0 1030.40 225.76",
  "//DIE_AREA_8x2": "0 0 1378.16 225.76",
  "//DIE_AREA_3x4": "0 0 508.76 511.36",
  "//DIE_AREA_4x4": "0 0 682.64 511.36",
  "//DIE_AREA_5x4": "0 0 856.52 511.36",
  "//DIE_AREA_6x4": "0 0 1030.40 511.36",
  "//DIE_AREA_8x4": "0 0 1378.16 511.36",

  "//52": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
  "//53": "!!!  DO NOT CHANGE ANYTHING BELOW THIS POINT             !!!",
  "//54": "!!!  These are Tiny Tapeout hardening requirements.      !!!",
  "//55": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
  "//56": "Skip KLayout checks to save time",
  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0,

  "//57": "Don't put clock buffers on the outputs",
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

  "//58": "Reduce wasted space around the die",
  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,

  "//59": "Use the absolute die size defined above",
  "FP_SIZING": "absolute",

  "GRT_ALLOW_CONGESTION": 1,

  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,

  "FP_PDN_VPITCH": 38.87,

  "//60": "Clock tree synthesis",
  "RUN_CTS": 1,

  "//61": "Don't generate power rings",
  "FP_PDN_MULTILAYER": 0,

  "//62": "MAGIC_DEF_LABELS may cause issues with LVS",
  "MAGIC_DEF_LABELS": 0,

  "FP_MACRO_VERTICAL_HALO": 0,
  "PDN_VERTICAL_HALO": 0,

  "RUN_POST_GRT_RESIZER_TIMING": true,

  "//63": "Only export pin area in LEF (without any connected nets)",
  "MAGIC_WRITE_LEF_PINONLY": 1,
  "MACROS": {
    "ipsp_serial": {
      "gds": [
        "dir::macros/ipsp_serial/ipsp_serial.gds"
      ],
      "lef": [
        "dir::macros/ipsp_serial/ipsp_serial.lef"
      ],
      "nl": [
        "dir::macros/ipsp_serial/ipsp_serial.nl.v"
      ],
      "pnl": [
        "dir::macros/ipsp_serial/ipsp_serial.pnl.v"
      ],
      "lib": {
        "max_ff_n40C_1v95": [
          "dir::macros/ipsp_serial/lib/max_ff_n40C_1v95.lib"
        ],
        "max_ss_100C_1v60": [
          "dir::macros/ipsp_serial/lib/max_ss_100C_1v60.lib"
        ],
        "max_tt_025C_1v80": [
          "dir::macros/ipsp_serial/lib/max_tt_025C_1v80.lib"
        ],
        "min_ff_n40C_1v95": [
          "dir::macros/ipsp_serial/lib/min_ff_n40C_1v95.lib"
        ],
        "min_ss_100C_1v60": [
          "dir::macros/ipsp_serial/lib/min_ss_100C_1v60.lib"
        ],
        "min_tt_025C_1v80": [
          "dir::macros/ipsp_serial/lib/min_tt_025C_1v80.lib"
        ],
        "nom_ff_n40C_1v95": [
          "dir::macros/ipsp_serial/lib/nom_ff_n40C_1v95.lib"
        ],
        "nom_ss_100C_1v60": [
          "dir::macros/ipsp_serial/lib/nom_ss_100C_1v60.lib"
        ],
        "nom_tt_025C_1v80": [
          "dir::macros/ipsp_serial/lib/nom_tt_025C_1v80.lib"
        ]
      },
      "spef": {
        "max_*": [
          "dir::macros/ipsp_serial/spef/max.spef"
        ],
        "min_*": [
          "dir::macros/ipsp_serial/spef/min.spef"
        ],
        "nom_*": [
          "dir::macros/ipsp_serial/spef/nom.spef"
        ]
      },
      "instances": {
        "u_ipsp1": { "location": [10.12, 2.72], "orientation": "FN" },
        "u_ipsp0": { "location": [63.94, 2.72], "orientation": "FN" }
      }
    }
  },
  "PDN_MACRO_CONNECTIONS": [
    "u_ipsp0 VPWR VGND VPWR VGND",
    "u_ipsp1 VPWR VGND VPWR VGND"
  ]
}
